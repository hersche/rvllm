# Source with: source profiles/gb10/mistral35-nvfp4
#
# Mistral Medium 3.5 128B on GB10: NVFP4 compressed-tensors weights,
# native Pixtral vision. Production-ready, multi-token greedy
# generation, SSE streaming.

export RVLLM_MODEL_DIR=/home/r00t/mistral-3.5
export RVLLM_MODEL_ID=mistral-3.5-nvfp4
export RVLLM_MODEL_FAMILY=mistral35
export RVLLM_KERNELS_DIR=/home/r00t/workspace/upstream/rvllm-serve/kernels
export RVLLM_CUTLASS_SM120_SO=/home/r00t/workspace/upstream/rvllm-serve/kernels/sm_121/libcutlass_sm120.so
export RVLLM_ARENA_GB=100
export RVLLM_BIND=127.0.0.1:8010
# Bumped 2 → 8 to match other families (gemma4-31b, qwen36-*). The
# old value silently capped the in-flight pipeline so even sequential
# zeroclaw turns could hit Busy responses on a warm decode.
export RVLLM_QUEUE_DEPTH=8
# Bumped 128 → 32768. The 128 cap dated to bring-up smoke tests
# where the kernel chain was capped. Real workloads now run up to
# 32k cumulative prompt+completion. Adjust further if memory
# permits.
export RVLLM_MAX_TOKENS_CAP=32768
# Mistral 3.5's runtime KV cap is a SEPARATE env from MAX_TOKENS_CAP
# (it sizes the per-layer KV arena + the YaRN RoPE table at boot).
# Default = config's original_max_position_embeddings = 4096, which
# rejected real zeroclaw prompts (~16k tokens). Raise to match
# MAX_TOKENS_CAP. At 32k positions, RoPE tables are ~16 MB and KV
# (BF16 + NVFP4 dual) is ~7.7 GB total — well inside the 100 GiB
# arena after weights (~70 GiB NVFP4).
export RVLLM_KV_CACHE_MAX_POS=32768
export RVLLM_REQUEST_TIMEOUT_SECS=600

# Vision (Pixtral) required for image_url requests.
export RVLLM_LOAD_VISION=1

# NVFP4 KV cache mode. Three options:
#   bf16        : BF16 KV only (legacy, smallest arena footprint at
#                 longer contexts after NVFP4 mirror is dropped)
#   nvfp4_dual  : BF16 authoritative + NVFP4 mirror. FA-decode reads
#                 BF16 (fast path), NVFP4 ride-along catches quant
#                 regressions. ~11.26 GiB KV at 32k context.
#   nvfp4_only  : NVFP4 only. Saves ~700 MB arena but FA-decode reads
#                 NVFP4 → 2-2.4× slower wallclock per request on the
#                 GB10 hot path. Net negative for production; useful
#                 only if KV arena is the binding constraint at >64k
#                 context.
# Hardware A/B (634-tok prompt + 30 decode, mistral 3.5):
#   nvfp4_dual: ~33.9s | nvfp4_only: ~79.9s (+135%)
# Stay on dual-write — the arena saving doesn't justify the perf hit.
export RVLLM_MISTRAL35_KV_MODE=nvfp4_dual

# FlashAttention-2 chunked prefill kernel. PTX is loaded
# unconditionally at bring-up; setting this gates the runtime
# dispatch so the chunk-prefill path uses the kernel rather than the
# split qk_dot+softmax+v_dot legacy chain. Verified safe; turn off
# only when bisecting prefill numerics.
export RVLLM_MISTRAL35_FA_PREFILL=1

# Fused W4A16 prefill GEMM variants (MMA v2..v8): all default OFF.
# Hardware A/B (long-prompt prefill on 634-tok input, 30-tok decode):
#   default (dequant → bf16_gemm_f32 → f32_to_bf16): 33.87s avg
#   MMA v8 (persistent CTA, cp.async 2-stage):       40.43s avg (+19%)
# Output byte-identical (md5 75d36e68) but the legacy bf16_gemm path
# is faster for Mistral 3.5's projection shapes — keep the variants
# off in production. Toggle V2..V8 explicitly when benching kernel-
# level perf changes.
