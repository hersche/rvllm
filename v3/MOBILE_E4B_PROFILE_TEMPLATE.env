# =====================================================================
#  rvllm profile TEMPLATE — Gemma 4 E4B-it (sm_121 / GB10)
#
#  STATUS: text-only foundation. E4B-it is the smaller Gemma 4 with
#  42 text layers (vs 31B's 60), hidden=2560, sliding_window=512, and
#  native bf16 safetensors. The existing F16_ONLY ingest path converts
#  bf16 → f16 at upload — no separate code path needed for weights.
#
#  ScopE wired in this profile (A1-A3 of the E4B plan):
#   - Loader accepts the bf16 layout (no `weight_scale` tensors) and
#     logs "pure-bf16 layout" on startup.
#   - num_kv_shared_layers=18 is parsed onto Gemma4LoadedModel; the
#     physical KV-share aliasing lands in A4 — until then bring-up
#     computes K/V independently for every layer (correct, slower).
#   - Vision tower (16 SigLIP-style blocks, hidden=768,
#     standardize=false) lands in A4. Vision-bearing requests will
#     work after A4; today they fall through the 31B vision dims
#     and produce garbage — disable images until A4 ships.
#   - Native audio (12-layer audio tower, mel frontend) is Thread B.
#
#  Activate (mutually exclusive with mobile-31b-rvllm and
#  mobile-qwen-rvllm — they all bind :8010):
#    sudo ln -sfn /home/r00t/.rvllm/profiles/mobile-e4b-rvllm.env \
#                 /home/r00t/.rvllm/active-profile.env
#    sudo systemctl restart rvllm-serve
# =====================================================================

# --- Mandatory paths ---
RVLLM_MODEL_DIR=/home/r00t/gemma4-e4b
RVLLM_MODEL_ID=gemma-4-e4b-it
RVLLM_KERNELS_DIR=/home/r00t/workspace/upstream/rvllm-serve/kernels
RVLLM_CUTLASS_SM120_SO=/home/r00t/workspace/upstream/rvllm-serve/kernels/sm_121/libcutlass_sm120.so

# --- Family selection ---
# Auto resolves to Gemma4 (architectures[0] = "Gemma4ForConditionalGeneration"
# is the Gemma 4 fallback in family.rs); explicit for clarity.
RVLLM_MODEL_FAMILY=gemma4

# --- Bind / queue / token caps ---
RVLLM_BIND=127.0.0.1:8010
RVLLM_QUEUE_DEPTH=8
RVLLM_MAX_TOKENS_CAP=4096
RVLLM_REQUEST_TIMEOUT_SECS=600

# --- Arena (HBM bump-allocator) ---
# E4B weights ~15 GiB bf16 → ~15 GiB f16 in HBM. KV (42 layers, mixed
# sliding 512 / 7 full attention), activations, and per-step scratch
# comfortably fit under 30 GiB on a 128 GiB GB10.
RVLLM_ARENA_GB=30

# --- F16-only weight path (REQUIRED for pure-bf16 E4B) ---
# bf16 → f16 conversion at upload; bypasses the FP8 channelscale
# cascade that the 31B fp8-block checkpoint relies on. Without this,
# the loader CPU-quantizes bf16 → f16 → fp8 round-trip (slow, wasted
# memory). The E4B layout has no `*_weight_scale` tensors so the
# fp8-prequant detect path correctly falls through.
RVLLM_F16_ONLY=1
RVLLM_F16_KV=1

# --- Batched prefill ---
# Same gates Gemma 4 31B uses in production.
RVLLM_BATCH_PREFILL=1
RVLLM_UNIFIED_PREFILL=1
RVLLM_UNIFIED_PREFILL_MMA=1
RVLLM_PREFILL_CHUNK_SIZE=2048

# --- Vision admission (suppressed pending A4) ---
# A4 will replace the 31B vision dims (hidden=1152, layers=27,
# standardize=true) with E4B's (hidden=768, layers=16,
# standardize=false). Until A4 lands, refuse vision-bearing requests
# at admission by setting MAX_IMAGES=0 — keeps text-only smoke clean.
RVLLM_VISION_MAX_IMAGES=0
